{% comment  %}
    Custom Banner section
    -Text  fields editable
    -Button  with animationn
    -Mobile responsive
{% endcomment %}

{% schema %}
{
  "name": "Gift Guide Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    }
  ]
}
{% endschema %}

<section class="gift-guide-banner" style="background-image:url({{ section.settings.background_image | image_url }});">
  <div class="gift-guide-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtext }}</p>
    {% if section.settings.button_link %}
      <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
  <div class="gift-guide-tagline">
    {{ section.settings.tagline }}
  </div>
</section>

<style>
.gift-guide-banner {
  background-size: cover;
  background-position: center;
  padding: 80px 20px;
  text-align: left;
  position: relative;
}
.gift-guide-content {
  max-width: 600px;
}
.gift-guide-content h1 {
  font-size: 42px;
  font-weight: bold;
}
.gift-guide-content p {
  margin: 15px 0;
  font-size: 18px;
}
.gift-guide-content .btn {
  display: inline-block;
  background: #000;
  color: #fff;
  padding: 12px 24px;
  text-decoration: none;
}
.gift-guide-tagline {
  margin-top: 40px;
  text-align: center;
  font-size: 14px;
  background: #f5f5f5;
  padding: 10px 0;
}
@media(max-width:768px) {
  .gift-guide-content h1 { font-size: 28px; }
  .gift-guide-content p { font-size: 16px; }
  .gift-guide-banner { padding: 40px 15px; text-align: center; }
}
</style>

